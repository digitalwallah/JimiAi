<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet for Claude API + YouTube Data API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Read contacts, so Jimi knows names/numbers and can store a language-style per contact -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Query installed apps (Android 11+ needs this to see other apps) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Foreground service, so Jimi keeps running while it operates other apps -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice input (mic button) aur voice output (Jimi bol ke reply de sake) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Seedha call lagane ke liye (permission diye bina Jimi sirf dialer kholega) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Always-listening background wake-word service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- onTaskRemoved restart alarm ke liye (app swipe hone ke baad service wapas jagane ke liye) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Incoming call detect karke caller ka naam announce karne ke liye -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- WhatsApp automation ke button-tap fallback overlay/diagnostics ke liye,
         aur ye declare karne se hi "Display over other apps" Settings mein dikhta hai -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Brightness aur rotation-lock control ke liye — special permission hai,
         user ko ek baar manually allow karni padegi (SystemControlHelper.requestWriteSettingsPermission()
         wo screen seedha khol deta hai) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- kuch OEM clock apps (jaise deskclock/.HandleSetAlarmApiCalls) ACTION_SET_ALARM ko
         strictly is permission ke bina block kar dete hain (SecurityException: Permission Denial).
         Ye ek normal, install-time permission hai — koi runtime dialog nahi maangega. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Screen-reading (OCR) feature ke liye: purane Android (11 se neeche) pe screenshot
         lene ka fallback tareeka MediaProjection hai, jiske liye ye foreground-service
         type declare karna zaroori hai Android 14+ target karne par. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Jimi"
        android:theme="@style/Theme.JimiAI"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Payment QR screen: user yahan se UPI QR scan karke UTR/phone submit karta hai -->
        <activity
            android:name=".PaymentQRActivity"
            android:exported="false" />

        <!-- The core Accessibility Service: this is what lets Jimi "see" the screen
             and tap/type on behalf of the user in any app (WhatsApp, YouTube, etc.) -->
        <service
            android:name=".JimiAccessibilityService"
            android:exported="true"
            android:label="Jimi Assistant"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Background always-listening wake-word service ("Jimi" bolte hi jaag jaata hai) -->
        <service
            android:name=".WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- PURANE Android (11 se neeche) ke liye screenshot capture fallback -
             MediaProjection permission ek baar mile ke baad ye service usko zinda rakhta hai. -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Proactive check-in ke liye BroadcastReceiver - alarm fire hone par notification dikhata hai -->
        <receiver
            android:name=".CheckInReceiver"
            android:exported="false" />

        <!-- Incoming/outgoing call state detect karke caller ka naam announce karta hai -->
        <receiver
            android:name=".CallAnnouncer"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Har ~15 min mein check karta hai ki WakeWordService zinda hai ya OEM ne maar diya;
             agar mar gayi ho to wapas start karta hai (FunTouch/OriginOS jaise OS ke liye) -->
        <receiver
            android:name=".WakeWordWatchdogReceiver"
            android:exported="false" />
        <!-- PDF file share/download karne ke liye — FileProvider ke bina Android 7+ pe
             file-sharing intent SecurityException ke saath crash karta hai -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
