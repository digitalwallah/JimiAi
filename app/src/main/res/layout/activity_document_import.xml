<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📄 Import Document"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Purani PDF ya image se naya professional PDF banao"
        android:textSize="13sp"
        android:textColor="#8A94A6"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnPickDocument"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Image ya PDF Select Karo"
        android:textColor="#0B1220"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:layout_marginBottom="24dp" />

    <ProgressBar
        android:id="@+id/progressImport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvImportStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#8A94A6"
        android:gravity="center" />

</LinearLayout>
