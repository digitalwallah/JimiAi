<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jimi_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jimi"
        android:textColor="@color/jimi_accent"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Accessibility service: OFF"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnEnableAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Accessibility Permission On Karo"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. API Keys Set Karo"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchAlwaysListening"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Always Listening (\'Jimi\' bolke jagao, screen off ho tab bhi)"
        android:textColor="@color/jimi_text"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchCheckIn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. Proactive Check-ins (Jimi din mein ek baar khud check-in karega)"
        android:textColor="@color/jimi_text"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/commandInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Jimi ko command do... jaise 'Rahul ko WhatsApp pe bolo main 10 min me aata hu'"
            android:textColor="@color/jimi_text"
            android:textColorHint="#64748B"
            android:padding="12dp"
            android:background="@color/jimi_bubble_user" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎤"
            android:layout_marginStart="6dp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bhejo"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
